---
// The competitive comparison: what else a trail manager can buy, read from the
// vendors' own public pages, with the one line per player that keeps this a
// comparison rather than an advertisement — what they do better than us.
//
// Three copy rules are load-bearing here and are documented at the `comparison`
// block in i18n/ui.ts: the install claim is never an account claim, every
// player names a strength, and the hosting claim is « hébergées au Canada »
// rather than « tout reste au Canada ». lib/comparison.ts fails the build if
// the second one goes missing.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { useTranslations, claimUrl, appUrl, contactEmail } from '../i18n/utils';
import { players } from '../lib/comparison';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const field = players(lang);

/** The three labelled facts every card carries, in one place so the two
    columns of every card line up down the grid. */
const rows = (p: (typeof field)[number]) => [
  { label: t.comparison.labels.visitor, value: p.visitor },
  { label: t.comparison.labels.data, value: p.data },
  { label: t.comparison.labels.pricing, value: p.pricing },
];
---

<BaseLayout
  lang={lang}
  title={t.comparison.metaTitle}
  description={t.comparison.metaDescription}
>
  <Header lang={lang} />

  <main>
    <!-- Hero: the promise of the page, and where its facts were read. -->
    <section class="mx-auto max-w-6xl px-5 pt-14 pb-12 sm:pt-16">
      <p class="font-mono text-sm font-semibold tracking-wide text-(--pine) uppercase">
        {t.comparison.kicker}
      </p>
      <h1
        class="mt-3 max-w-3xl font-display text-4xl leading-[1.06] font-extrabold tracking-[-0.03em] text-(--ink) sm:text-5xl"
      >
        {t.comparison.title}<span class="text-(--blaze)">.</span>
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-(--sub)">{t.comparison.lead}</p>
      <p class="mt-6 max-w-2xl text-sm leading-relaxed text-(--sub)">
        {t.comparison.readingNote}
      </p>
    </section>

    <!-- The field: one card per alternative, each ending on its own strength. -->
    <section class="border-t border-(--line)">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
        <h2 class="font-display text-3xl font-extrabold tracking-[-0.02em] text-(--ink) sm:text-4xl">
          {t.comparison.fieldTitle}<span class="text-(--blaze)">.</span>
        </h2>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-(--sub)">
          {t.comparison.fieldLead}
        </p>

        <div class="mt-10 grid gap-6 lg:grid-cols-2">
          {
            field.map((p) => (
              <article class="flex flex-col rounded-(--radius-card) border border-(--line) bg-(--card) p-6 sm:p-7">
                <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                  <h3 class="font-display text-2xl font-bold tracking-[-0.02em] text-(--ink)">
                    {p.name}
                  </h3>
                  <span class="rounded-full border border-(--line) bg-(--quiet) px-2.5 py-0.5 font-mono text-[11px] font-semibold tracking-wide text-(--sub) uppercase">
                    {p.origin}
                  </span>
                </div>
                <p class="mt-3 leading-relaxed text-(--sub)">{p.what}</p>

                <dl class="mt-6 flex flex-col gap-4 border-t border-(--line) pt-5">
                  {rows(p).map((row) => (
                    <div>
                      <dt class="font-mono text-xs font-semibold tracking-wide text-(--pine) uppercase">
                        {row.label}
                      </dt>
                      <dd class="mt-1.5 leading-relaxed text-(--sub)">{row.value}</dd>
                    </div>
                  ))}
                </dl>

                {/* Our position carries the card's emphasis. An earlier cut gave
                    the highlighted panel to the competitor's strength, which put
                    the loudest words on every card in someone else's favour on
                    our own site. */}
                <div class="mt-6 rounded-(--radius-control) bg-(--quiet) p-5">
                  <p class="flex items-center gap-2.5 font-mono text-xs font-semibold tracking-wide text-(--pine) uppercase">
                    {t.comparison.labels.versus}
                  </p>
                  <p class="mt-2.5 leading-relaxed text-(--ink)">{p.versus}</p>
                </div>

                {/* The qualification, kept and kept quiet: one line, no panel,
                    framed as the need they serve rather than as our deficit. It
                    disqualifies a bad-fit buyer on the page instead of in a
                    meeting, and it is what makes the land claim above credible. */}
                <div class="mt-5">
                  <p class="font-mono text-xs font-semibold tracking-wide text-(--sub) uppercase">
                    {t.comparison.labels.need}
                  </p>
                  <p class="mt-1.5 text-sm leading-relaxed text-(--sub)">{p.need}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Ours: the painted sign, carrying the one mechanism nobody else has. -->
    <section id="ours" class="bg-(--ink-band,#0f1f1a)">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
        <p class="font-mono text-sm font-semibold tracking-wide text-[#7fb59d] uppercase">
          {t.comparison.ours.kicker}
        </p>
        <h2
          class="mt-3 max-w-3xl font-display text-3xl font-extrabold tracking-[-0.02em] text-[#f1f4ee] sm:text-4xl"
        >
          {t.comparison.ours.title}<span class="text-[#e2703a]">.</span>
        </h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-[#d5e0d3]">
          {t.comparison.ours.lead}
        </p>

        <div class="mt-12 grid gap-x-10 gap-y-8 sm:grid-cols-3">
          {
            t.comparison.ours.points.map((point, i) => (
              <div class="border-t border-[#2e5a4c] pt-5">
                <span class="font-mono text-sm font-semibold text-[#7fb59d]">{i + 1}/3</span>
                <h3 class="mt-3 font-display text-lg font-bold tracking-[-0.02em] text-[#f1f4ee]">
                  {point.title}
                </h3>
                <p class="mt-2 leading-relaxed text-[#b7c4b2]">{point.body}</p>
              </div>
            ))
          }
        </div>

        {/* The mechanism told as one morning's consequence. Deliberately not a
            named customer: the situation it describes is a landowner's private
            business, and the argument works without putting anyone's property
            line on a public page. */}
        <div class="mt-14 max-w-3xl rounded-(--radius-card) border border-[#2e5a4c] p-6 sm:p-8">
          <h3 class="font-display text-xl font-bold tracking-[-0.02em] text-[#f1f4ee]">
            {t.comparison.ours.proofTitle}
          </h3>
          <p class="mt-3 text-lg leading-relaxed text-[#d5e0d3]">
            {t.comparison.ours.proofBody}
          </p>
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a
            href={claimUrl}
            class="rounded-(--radius-control) bg-[#e2703a] px-6 py-3.5 text-base font-bold text-[#0f1f1a] transition-opacity duration-200 hover:opacity-90"
            >{t.nav.claim}</a
          >
          <a
            href={appUrl}
            class="font-semibold text-[#f1f4ee] underline decoration-[#2e5a4c] underline-offset-4 hover:decoration-[#e2703a]"
            >{t.sticker.orCta}</a
          >
        </div>
      </div>
    </section>

    <!-- What we cede, by name. The section that makes the rest believable. -->
    <section class="border-t border-(--line)">
      <div class="mx-auto max-w-6xl px-5 py-16 sm:py-20">
        <h2 class="font-display text-3xl font-extrabold tracking-[-0.02em] text-(--ink) sm:text-4xl">
          {t.comparison.notUs.title}<span class="text-(--blaze)">.</span>
        </h2>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-(--sub)">
          {t.comparison.notUs.lead}
        </p>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {
            t.comparison.notUs.cards.map((card) => (
              <article class="rounded-(--radius-card) border border-(--line) bg-(--card) p-6">
                <div class="flex items-center gap-3">
                  <span class="blaze-stripe" aria-hidden="true" />
                </div>
                <h3 class="mt-4 font-display text-xl font-bold tracking-[-0.02em] text-(--ink)">
                  {card.title}
                </h3>
                <p class="mt-2 leading-relaxed text-(--sub)">{card.body}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Close: the correction invitation is the whole page's warranty. -->
    <section class="mx-auto max-w-6xl px-5 py-20">
      <div class="rounded-(--radius-sheet) bg-(--quiet) px-6 py-14 text-center sm:px-12">
        <h2
          class="mx-auto max-w-2xl font-display text-3xl font-extrabold tracking-[-0.02em] text-(--ink) sm:text-4xl"
        >
          {t.comparison.correctionTitle}
        </h2>
        <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-(--sub)">
          {t.comparison.correctionBody}
        </p>
        <div class="mt-8 flex flex-col items-center gap-4">
          <a
            href={`mailto:${contactEmail}`}
            class="rounded-(--radius-control) bg-(--blaze) px-7 py-4 font-mono text-base font-bold text-white transition-colors duration-200 hover:bg-(--blaze-hover) active:bg-(--blaze-press)"
            >{contactEmail}</a
          >
          <p class="text-sm text-(--sub)">
            {t.ctaBand.reportLead}{' '}
            <a
              href={appUrl}
              class="font-semibold text-(--ink) underline decoration-(--line) underline-offset-4 hover:decoration-(--blaze)"
              >{t.ctaBand.reportCta}</a
            >
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  /* The same painted-sign treatment the landing and tour bands use. */
  #ours {
    --ink-band: #0f1f1a;
  }
  @media (prefers-color-scheme: dark) {
    #ours {
      --ink-band: #161d16;
    }
  }
</style>
