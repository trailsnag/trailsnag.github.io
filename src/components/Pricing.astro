---
// The pricing page: what TrailSnag costs, and the door that takes the money.
//
// This is the surface the whole sell-then-provision order rests on. A buyer
// pays HERE, before anybody has minted their organization — setup is not
// self-serve, because a territory has to be claimed and verified first — so
// the button leads to the payment provider and the steward is provisioned
// afterwards, by hand, from the operator queue.
//
// Every amount comes from lib/pricing.ts rather than from the copy, so the two
// locales cannot quote different numbers. Two things §4 asks for are said out
// loud rather than implied: Halte is free with no interview and no annual
// review, and taxes are extra. Two things §4 forbids are absent: the cadastre
// (its lot data is not loaded, so selling it would sell an empty picker) and
// the Territoire anchor (12 000 $ is what you say in a call after hearing what
// somebody needs, not a number published beside two self-serve buttons).
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { useTranslations, claimUrl, contactEmail } from '../i18n/utils';
import { TIERS, money, offer, type Tier } from '../lib/pricing';
import { contactPath, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const contact = contactPath(lang);

/** What each tier opens, mirroring PLAN_CAPABILITIES in the product. Exports
    sit on EVERY tier deliberately: they are the org's own data, and gating
    them would make a late payment a data-hostage situation. */
const OPENS: Record<Tier['key'], string[]> = {
  halte: [t.pricing.rows.base, t.pricing.rows.exports],
  parc: [t.pricing.rows.resolution, t.pricing.rows.network],
  reseau: [t.pricing.rows.webhooks],
  territoire: [],
};

const support: Record<Tier['key'], string> = {
  halte: t.pricing.support.halte,
  parc: t.pricing.support.parc,
  reseau: t.pricing.support.reseau,
  territoire: t.pricing.support.territoire,
};
---

<BaseLayout lang={lang} title={t.pricing.title} description={t.pricing.lede}>
  <Header lang={lang} />
  <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
    <h1 class="font-display text-3xl font-bold text-balance text-(--ink) sm:text-4xl">
      {t.pricing.title}
    </h1>
    <p class="mt-3 max-w-2xl text-lg text-(--ink-soft)">{t.pricing.lede}</p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        TIERS.map((tier) => {
          const copy = t.pricing.tiers[tier.key];
          const paid = tier.monthly !== null && tier.monthly > 0;
          // Guaranteed live: lib/pricing.ts fails the build on a missing link,
          // so nothing here has to reason about a half-configured page.
          const monthly = offer(tier.monthlyUrl);
          const yearly = offer(tier.yearlyUrl);
          return (
            <section class="flex flex-col rounded-2xl border border-(--rule) bg-(--paper) p-5">
              <h2 class="font-display text-xl font-bold text-(--ink)">{copy.name}</h2>
              <p class="mt-1 text-xs font-semibold tracking-wide text-(--ink-soft) uppercase">
                {copy.who}
              </p>

              <p class="mt-4 font-display text-3xl font-bold text-(--ink)">
                {tier.monthly === null ? (
                  t.pricing.quoted
                ) : (
                  <>
                    {money(tier.monthly, lang)}
                    <span class="ml-1 text-sm font-semibold text-(--ink-soft)">
                      {t.pricing.monthlySuffix}
                    </span>
                  </>
                )}
              </p>
              {paid && tier.yearly !== null && (
                <p class="mt-1 text-sm text-(--ink-soft)">
                  {t.pricing.yearlyNote.replace('{price}', money(tier.yearly, lang))}
                </p>
              )}

              <p class="mt-4 text-sm text-(--ink-soft)">{copy.pitch}</p>
              {tier.key === 'halte' && (
                <p class="mt-3 text-sm font-semibold text-(--ink)">{t.pricing.freeForever}</p>
              )}

              <ul class="mt-4 space-y-1.5 text-sm text-(--ink-soft)">
                {OPENS[tier.key].map((line) => (
                  <li>{line}</li>
                ))}
              </ul>

              <dl class="mt-4 space-y-1 text-xs text-(--ink-soft)">
                <div class="flex justify-between gap-3">
                  <dt>{t.pricing.labels.territories}</dt>
                  <dd class="font-semibold text-(--ink)">{tier.territories}</dd>
                </div>
                <div class="flex justify-between gap-3">
                  <dt>{t.pricing.labels.seats}</dt>
                  <dd class="font-semibold text-(--ink)">{t.pricing.labels.unlimited}</dd>
                </div>
                <div class="flex justify-between gap-3">
                  <dt>{t.pricing.labels.support}</dt>
                  <dd class="font-semibold text-(--ink)">{support[tier.key]}</dd>
                </div>
              </dl>

              {/* The doors. `mt-auto` pins them to the bottom so four cards of
                  different heights still line their buttons up. */}
              <div class="mt-auto pt-5">
                {tier.key === 'halte' && (
                  <a
                    href={claimUrl}
                    class="block rounded-lg bg-(--blaze) px-3 py-2 text-center font-display text-sm font-bold text-white"
                  >
                    {copy.cta}
                  </a>
                )}
                {tier.key === 'territoire' && (
                  <a
                    href={contact}
                    class="block rounded-lg border border-(--rule) px-3 py-2 text-center font-display text-sm font-bold text-(--ink)"
                  >
                    {copy.cta}
                  </a>
                )}
                {/* Both intervals, both real. Annual is the cash-flow win for
                    a solo founder and the better deal for the buyer, so it is a
                    button rather than a footnote somebody has to ask about. */}
                {paid && (
                  <div class="space-y-2">
                    <a
                      href={monthly.href}
                      class="block rounded-lg bg-(--blaze) px-3 py-2 text-center font-display text-sm font-bold text-white"
                    >
                      {copy.cta}
                    </a>
                    <a
                      href={yearly.href}
                      class="block rounded-lg border border-(--rule) px-3 py-2 text-center font-display text-xs font-bold text-(--ink)"
                    >
                      {t.pricing.yearlyCta.replace('{price}', money(tier.yearly ?? 0, lang))}
                    </a>
                  </div>
                )}
              </div>
            </section>
          );
        })
      }
    </div>

    <p class="mt-6 text-sm text-(--ink-soft)">{t.pricing.taxes}</p>

    {/* §4 puts these in a footer rather than in a tier box, because they are
        true of every tier including the free one. */}
    <div class="mt-8 space-y-2 border-t border-(--rule) pt-6 text-sm text-(--ink-soft)">
      <p>{t.pricing.footnotes.canada}</p>
      <p>{t.pricing.footnotes.install}</p>
      <p>{t.pricing.footnotes.seats}</p>
      <p>
        <a class="underline hover:text-(--ink)" href={`mailto:${contactEmail}`}>
          {contactEmail}
        </a>
      </p>
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>
