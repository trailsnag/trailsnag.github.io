---
// The pricing page: three cards, one price each, one button each.
//
// It is built to the shape every buyer has already seen a hundred times,
// because a price grid is scanned in about four seconds and anything
// unfamiliar in it costs more than it explains. Name, one line saying who it
// is for, the amount, the button, then a checked list. Nothing else.
//
// THE ALIGNMENT IS THE WHOLE LAYOUT, and it is why the rows are fixed rather
// than flowed: a « who » line that wraps on one card and not on another puts
// three prices at three different heights and the grid stops reading as a
// comparison at all. The name+who block and the price block each hold their
// own height whatever they contain, so the amounts sit on one line across the
// three cards, the buttons sit on another, and the lists start together. The
// anchor's ribbon is positioned OUT OF FLOW against the card's top edge for
// the same reason — in flow it pushed that one card's contents down and broke
// every row it was meant to draw attention to.
//
// Every amount comes from lib/pricing.ts rather than from the copy, so the
// two locales cannot quote different numbers, and four build guards there
// refuse the page outright if the arithmetic, the links, the spread or the
// order of the tiers stop agreeing with what the words promise.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { useTranslations, claimUrl } from '../i18n/utils';
import { TIERS, RATES, money, offer, type Rate, type Tier } from '../lib/pricing';
import { contactPath, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const contact = contactPath(lang);

const rateLabel: Record<Rate, string> = {
  nonprofit: t.pricing.rate.nonprofit,
  commercial: t.pricing.rate.commercial,
};

/** The anchor, marked by a ribbon and a ring rather than by colour alone. */
const ANCHOR: Tier['key'] = 'parc';
---

<BaseLayout lang={lang} title={t.pricing.title} description={t.pricing.lede}>
  <Header lang={lang} />
  <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:py-14">
    <h1 class="font-display text-3xl font-bold text-balance text-(--ink) sm:text-4xl">
      {t.pricing.title}
    </h1>
    <p class="mt-2 text-(--ink-soft)">{t.pricing.lede}</p>

    {/* The rate switch works with NO JAVASCRIPT: the site is a static build
        with no hydration, so two real radios sit first and plain CSS reaches
        forward into their later siblings. A `:has()` on the grid cannot see
        radios outside it, and Tailwind's `peer-checked` needs the styled
        element to be the input's own sibling — both were tried, and both
        silently showed every card twice. */}
    <div class="rate-scope mt-7">
      <input type="radio" name="rate" id="rate-nonprofit" class="sr-only" checked />
      <input type="radio" name="rate" id="rate-commercial" class="sr-only" />

      <div class="flex flex-col gap-2 sm:flex-row" role="group" aria-label={t.pricing.rate.legend}>
        <label
          for="rate-nonprofit"
          class="cursor-pointer rounded-full border border-(--rule) px-4 py-1.5 text-center font-display text-sm font-semibold text-(--ink-soft)"
        >
          {rateLabel.nonprofit}
        </label>
        <label
          for="rate-commercial"
          class="cursor-pointer rounded-full border border-(--rule) px-4 py-1.5 text-center font-display text-sm font-semibold text-(--ink-soft)"
        >
          {rateLabel.commercial}
        </label>
      </div>

      {/* Shown only on the organisme rate, because it is the only one with a
          condition. It states WHO the rate is for and promises no procedure. */}
      <p data-rate="nonprofit" class="mt-3 text-sm text-(--ink-faint)">{t.pricing.rateNote}</p>

      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          TIERS.map((tier) => {
            const copy = t.pricing.tiers[tier.key];
            const paid = tier.rates.nonprofit.monthly > 0;
            const anchor = tier.key === ANCHOR;
            return (
              <section
                class={`relative flex flex-col rounded-2xl border bg-(--paper) p-6 ${
                  anchor ? 'border-(--blaze) ring-1 ring-(--blaze)' : 'border-(--rule)'
                }`}
              >
                {anchor && (
                  <p class="absolute -top-3 left-6 rounded-full bg-(--blaze) px-3 py-0.5 font-display text-[11px] font-bold tracking-wide text-white uppercase">
                    {t.pricing.anchorBadge}
                  </p>
                )}

                {/* Row 1 — who. Fixed height so three cards agree. */}
                <div class="min-h-14">
                  <h2 class="font-display text-lg font-bold text-(--ink)">{copy.name}</h2>
                  <p class="mt-1 text-sm text-(--ink-soft)">{copy.who}</p>
                </div>

                {/* Row 2 — the amount, in the size it is read at across a
                    meeting room. Both rates render; CSS shows one. */}
                <div class="min-h-16">
                  {RATES.map((rate) => (
                    <p data-rate={rate} class="flex flex-wrap items-baseline gap-x-2">
                      <span class="font-display text-4xl font-bold text-(--ink)">
                        {money(tier.rates[rate].monthly, lang)}
                      </span>
                      <span class="text-(--ink-soft)">{t.pricing.monthlySuffix}</span>
                    </p>
                  ))}
                </div>

                {/* Row 2b — the launch offer. It is carried by the MONTHLY
                    links alone, because the yearly price already contains two
                    months, and Halte holds the row with no text rather than
                    losing it: a row that exists on two cards and not on the
                    third puts the three buttons at three heights, which is
                    the one thing this layout cannot afford. */}
                <p class="mt-3 min-h-6 font-display text-sm font-bold text-(--blaze)">
                  {paid ? t.pricing.trialBadge : '\u00a0'}
                </p>

                {/* Row 3 — one button, where a buyer expects it: under the
                    price, not at the bottom of a list they have to read
                    first. The annual door is a quiet line beneath it rather
                    than a second button competing with the first. */}
                <div class="mt-4">
                  {tier.key === 'halte' ? (
                    <a
                      href={claimUrl}
                      class="block rounded-lg bg-(--blaze) px-3 py-2.5 text-center font-display text-sm font-bold text-white"
                    >
                      {copy.cta}
                    </a>
                  ) : (
                    RATES.map((rate) => (
                      <div data-rate={rate}>
                        <a
                          href={offer(tier.rates[rate].monthlyUrl, lang).href}
                          class="block rounded-lg bg-(--blaze) px-3 py-2.5 text-center font-display text-sm font-bold text-white"
                        >
                          {copy.cta}
                        </a>
                        <a
                          href={offer(tier.rates[rate].yearlyUrl, lang).href}
                          class="mt-2 block text-center text-xs text-(--ink-soft) underline hover:text-(--ink)"
                        >
                          {t.pricing.yearlyCta.replace(
                            '{price}',
                            money(tier.rates[rate].yearly, lang),
                          )}
                        </a>
                      </div>
                    ))
                  )}
                  {!paid && <span class="mt-2 block text-center text-xs">&nbsp;</span>}
                </div>

                {/* Row 4 — what you get, checked. */}
                <ul class="mt-6 space-y-2 text-sm text-(--ink-soft)">
                  {copy.features.map((f) => (
                    <li class="flex gap-2">
                      <span aria-hidden="true" class="text-(--blaze)">✓</span>
                      <span>{f}</span>
                    </li>
                  ))}
                </ul>
              </section>
            );
          })
        }
      </div>
    </div>

    {/* What the badge above cannot say in three words: which billing it
        applies to, the exact number of days Stripe counts, and that a card is
        asked for. An offer whose terms are only discovered at checkout is the
        kind of pleasant surprise that turns into a complaint. */}
    <p class="mt-6 max-w-2xl text-sm text-(--ink-faint)">{t.pricing.trialNote}</p>

    <p class="mt-6 text-sm text-(--ink-soft)">
      <a class="underline hover:text-(--ink)" href={contact}>{t.pricing.territoire}</a>
    </p>

  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  /* The rate switch: each rule reaches FORWARD from a checked radio into a
     later sibling's descendants, which is the only direction a sibling
     combinator goes — and the reason the radios are the container's first
     children. */
  #rate-nonprofit:checked ~ * [data-rate='commercial'],
  #rate-commercial:checked ~ * [data-rate='nonprofit'] {
    display: none;
  }

  /* The chosen pill inverts ground and ink, so it reads as pressed rather
     than merely tinted. */
  #rate-nonprofit:checked ~ * label[for='rate-nonprofit'],
  #rate-commercial:checked ~ * label[for='rate-commercial'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  /* The inputs are visually hidden but still focusable, so the focus ring is
     drawn on the label a keyboard user can actually see. */
  #rate-nonprofit:focus-visible ~ * label[for='rate-nonprofit'],
  #rate-commercial:focus-visible ~ * label[for='rate-commercial'] {
    outline: 2px solid var(--blaze);
    outline-offset: 2px;
  }
</style>
