---
// The Blazed Pin mark (logo direction A): the map-pin teardrop with the tilted
// blaze stripe knocked out in negative space. Same evenodd path as the app icon.
import { SNAG_MARK_PATH, SNAG_MARK_VIEWBOX } from '../lib/brand-mark.mjs';

interface Props {
  class?: string;
}
const { class: className = 'h-8 w-auto' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={`0 0 ${SNAG_MARK_VIEWBOX.width} ${SNAG_MARK_VIEWBOX.height}`}
  class={className}
  aria-hidden="true"
  fill="currentColor"
>
  <path fill-rule="evenodd" d={SNAG_MARK_PATH}></path>
</svg>
