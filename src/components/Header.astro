---
import Wordmark from './Wordmark.astro';
import LangSwitch from './LangSwitch.astro';
import { useTranslations, appUrl, claimUrl } from '../i18n/utils';
import { comparisonPath, pricingPath, type Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  /** Landing pages show the section anchors; legal pages keep the chrome only. */
  anchors?: boolean;
}
const { lang, anchors = false } = Astro.props;
const t = useTranslations(lang);
const home = lang === 'fr' ? '/' : '/en/';
---

<header class="border-b border-(--line)">
  <div
    class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-4 max-[380px]:gap-2 max-[380px]:px-3 sm:gap-4 sm:px-5"
  >
    <a href={home} class="text-(--ink) no-underline"><Wordmark class="text-lg max-[380px]:text-base sm:text-2xl" /></a>
    <div class="flex items-center gap-2 sm:gap-5">
      {/* The section anchors are landing-only, but the comparison is a PAGE and
          rides here on every one of them: a buyer mid-comparison looks in the
          nav, and it was reachable only at 92% of the home page and in the
          footer. Below lg the row has no space for either — the footer link and
          the in-page line under « Pour qui » are the doors there. */}
      <nav class="hidden items-center gap-5 lg:flex" aria-label={t.nav.main}>
        {/* The four French labels need ~508px and only clear it past xl —
            at a real 1024 window the classic scrollbar leaves 1009 and two of
            them wrapped to a second line. The anchors are the half that can
            wait for the room; the comparison link is the one with a job. */}
        {anchors && (
          <span class="hidden items-center gap-5 xl:flex">
            <a href="#how" class="text-sm font-semibold text-(--sub) hover:text-(--ink)">
              {t.nav.how}
            </a>
            <a href="#rewards" class="text-sm font-semibold text-(--sub) hover:text-(--ink)">
              {t.nav.rewards}
            </a>
            <a href="#stewards" class="text-sm font-semibold text-(--sub) hover:text-(--ink)">
              {t.nav.stewards}
            </a>
          </span>
        )}
        <a
          href={pricingPath(lang)}
          class="text-sm font-semibold text-(--sub) hover:text-(--ink)">{t.nav.pricing}</a
        >
        <a
          href={comparisonPath(lang)}
          class="text-sm font-semibold text-(--sub) hover:text-(--ink)">{t.nav.compare}</a
        >
      </nav>
      <LangSwitch lang={lang} />
      {/* Both doors into the app, on every screen size: the reporter opens the
          map (position routes the snag), the steward opens the desk (which is
          also the sign-in). Hiding these on phones left the visitor who is
          standing on the trail with no way in. */}
      <a
        href={claimUrl}
        class="rounded-(--radius-control) border border-(--line) px-2 py-2 text-xs font-bold text-(--ink) transition-colors duration-200 hover:border-(--pine) sm:px-3 sm:text-sm"
        >{t.nav.desk}</a
      >
      <a
        href={appUrl}
        class="rounded-(--radius-control) bg-(--blaze) px-2.5 py-2 text-xs font-bold text-white transition-colors duration-200 hover:bg-(--blaze-hover) active:bg-(--blaze-press) sm:px-4 sm:text-sm"
        >{t.nav.open}</a
      >
    </div>
  </div>
</header>
